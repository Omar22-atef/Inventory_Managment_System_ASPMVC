```razor
@model IEnumerable<Supplier>

@{
    ViewData["Title"] = "Suppliers Without Transactions";
}

<h1>Suppliers Without Transactions</h1>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Address</th>
            <th>City</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var supplier in Model)
        {
            <tr>
                <td>@supplier.Name</td>
                <td>@supplier.Address</td>
                <td>@supplier.City</td>
            </tr>
        }
    </tbody>
</table>
```
