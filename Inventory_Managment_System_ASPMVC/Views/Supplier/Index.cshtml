@model IEnumerable<Supplier>
@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Supplier</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Address</th>
            <th>City</th>
            <th>Edit</th>
            <th>Delete</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var supplier in Model)
        {
            <tr>
                <td>@supplier.Name</td>
                <td>@supplier.Address</td>
                <td>@supplier.City</td>
				<td><a asp-action="Edit" asp-route-id="@supplier.Id">Edit</a></td>
				<td><a asp-action="Delete" asp-route-id="@supplier.Id">Delete</a></td>
            </tr>
        }
    </tbody>
</table>

