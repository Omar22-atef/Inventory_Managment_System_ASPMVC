@model IEnumerable<Inventory_Managment_System_ASPMVC.Models.InventoryTransaction>


@{
    ViewData["Title"] = "Transactions";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Inventory Transactions</h2>
        <p class="text-muted mb-0">Track product movements in and out</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Add Transaction
    </a>
</div>

<!-- Filter Toolbar -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <div class="row g-2 align-items-center">
            <div class="col-12 col-sm-auto">
                <span class="text-muted small fw-bold text-uppercase d-block mb-1">Filter by Type</span>
                <div class="d-flex gap-2 flex-wrap">
                    <a asp-action="GetByType" asp-route-type="Purchase" class="btn btn-sm btn-outline-success">
                        <i class="bi bi-cart-check me-1"></i> Purchase
                    </a>
                    <a asp-action="GetByType" asp-route-type="Sale" class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-bag me-1"></i> Sale
                    </a>
                    <a asp-action="GetByType" asp-route-type="Return" class="btn btn-sm btn-outline-warning">
                        <i class="bi bi-arrow-return-left me-1"></i> Return
                    </a>
                    <a asp-action="GetByType" asp-route-type="AdjustmentIncrease" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-plus-circle me-1"></i> Increase
                    </a>
                    <a asp-action="GetByType" asp-route-type="AdjustmentDecrease" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-dash-circle me-1"></i> Decrease
                    </a>
                </div>
            </div>
            <div class="col-12 col-sm-auto ms-sm-auto">
                <span class="text-muted small fw-bold text-uppercase d-block mb-1">Filter by Date Range</span>
                <a asp-action="GetByDate" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-calendar-range me-1"></i> Search by Date
                </a>
            </div>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info d-flex align-items-center" role="alert">
        <i class="bi bi-info-circle-fill me-3 fs-4"></i>
        <div>
            <h5 class="alert-heading mb-1">No transactions found</h5>
            <p class="mb-0">There are currently no inventory transactions to display.</p>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Product</th>
                            <th>Supplier</th>
                            <th class="text-center">Quantity</th>
                            <th class="text-center">Type</th>
                            <th>Date</th>
                            <th class="text-end pe-4">Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var transaction in Model)
                        {
                            <tr>
                                <td class="ps-4 text-muted small">#@transaction.Id</td>
                                <td class="fw-medium text-dark">
                                    <div class="d-flex align-items-center">
                                        <div class="kpi-icon bg-light text-secondary me-3" style="width: 32px; height: 32px; font-size: 1rem;">
                                            <i class="bi bi-box"></i>
                                        </div>
                                        @transaction.Product.Name
                                    </div>
                                </td>
                                <td>
                                    <span class="text-muted">@(transaction.Supplier?.Name ?? "N/A")</span>
                                </td>
                                <td class="text-center fw-bold">
                                    @transaction.Quantity
                                </td>
                                <td class="text-center">
                                    @if (transaction.Type.ToString() == "In")
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2">
                                            <i class="bi bi-arrow-down-circle me-1"></i> Stock In
                                        </span>
                                    }
                                    else if (transaction.Type.ToString() == "Out")
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-2">
                                            <i class="bi bi-arrow-up-circle me-1"></i> Stock Out
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@transaction.Type</span>
                                    }
                                </td>
                                <td class="text-muted small">
                                    @transaction.Date.ToString("dd MMM yyyy")<br />
                                    <span class="opacity-75">@transaction.Date.ToString("HH:mm")</span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="GetById" asp-route-id="@transaction.Id"
                                       class="btn btn-sm btn-outline-secondary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}