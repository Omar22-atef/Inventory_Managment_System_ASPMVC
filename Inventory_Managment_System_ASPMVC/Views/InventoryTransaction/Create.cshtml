@model InventoryTransactionCreateViewModel

@{
    ViewData["Title"] = "Create Transaction";
}

<div class="mb-4">
    <h2 class="fw-bold mb-1">Create Transaction</h2>
    <p class="text-muted mb-0">Record a new stock movement</p>
</div>

<div class="row">
    <div class="col-xl-8 col-lg-10">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Create" method="post">
                    
                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label asp-for="ProductId" class="form-label fw-bold">Product</label>
                            <select asp-for="ProductId" asp-items="Model.Products" class="form-select">
                                <option value="">-- Select Product --</option>
                            </select>
                            <span asp-validation-for="ProductId" class="text-danger small"></span>
                        </div>
                        
                        <div class="col-md-6">
                            <label asp-for="SupplierId" class="form-label fw-bold">Supplier (Optional)</label>
                            <select asp-for="SupplierId" asp-items="Model.Suppliers" class="form-select">
                                <option value="">-- Select Supplier --</option>
                            </select>
                            <span asp-validation-for="SupplierId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-4 mb-5">
                        <div class="col-md-6">
                            <label asp-for="Quantity" class="form-label fw-bold">Quantity</label>
                            <div class="input-group">
                                <input asp-for="Quantity" type="number" class="form-control" min="1" placeholder="e.g. 50" />
                                <span class="input-group-text bg-light">Units</span>
                            </div>
                            <span asp-validation-for="Quantity" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Type" class="form-label fw-bold">Transaction Type</label>
                            <select asp-for="Type" asp-items="Html.GetEnumSelectList<InventoryTransactionType>()" class="form-select">
                                <option value="">-- Select Type --</option>
                            </select>
                            <span asp-validation-for="Type" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i> Record Transaction
                        </button>
                        <a asp-action="Index" class="btn btn-light px-4 border">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}