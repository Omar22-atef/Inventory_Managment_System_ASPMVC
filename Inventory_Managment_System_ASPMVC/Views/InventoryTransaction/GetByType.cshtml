@model IEnumerable<Inventory_Managment_System_ASPMVC.Models.InventoryTransaction>

@{
    ViewData["Title"] = "Transactions By Type";
    var typeLabel = Context.Request.Query["type"].ToString();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Transactions by Type</h2>
        <p class="text-muted mb-0">
            Showing:
            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1">
                @typeLabel
            </span>
        </p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="GetByType" asp-route-type="Purchase" class="btn btn-sm btn-outline-success">
            <i class="bi bi-cart-check me-1"></i> Purchase
        </a>
        <a asp-action="GetByType" asp-route-type="Sale" class="btn btn-sm btn-outline-danger">
            <i class="bi bi-bag me-1"></i> Sale
        </a>
        <a asp-action="GetByType" asp-route-type="Return" class="btn btn-sm btn-outline-warning">
            <i class="bi bi-arrow-return-left me-1"></i> Return
        </a>
        <a asp-action="Index" class="btn btn-light border">
            <i class="bi bi-arrow-left me-1"></i> All
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info d-flex align-items-center" role="alert">
        <i class="bi bi-info-circle-fill me-3 fs-4"></i>
        <div>No transactions found for this type.</div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Product</th>
                            <th>Supplier</th>
                            <th class="text-center">Quantity</th>
                            <th class="text-center">Type</th>
                            <th>Date</th>
                            <th class="text-end pe-4">Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var transaction in Model)
                        {
                            <tr>
                                <td class="ps-4 text-muted small">#@transaction.Id</td>
                                <td class="fw-medium">@transaction.Product.Name</td>
                                <td class="text-muted">@(transaction.Supplier?.Name ?? "N/A")</td>
                                <td class="text-center fw-bold">@transaction.Quantity</td>
                                <td class="text-center">
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1">
                                        @transaction.Type
                                    </span>
                                </td>
                                <td class="text-muted small">@transaction.Date.ToString("dd MMM yyyy HH:mm")</td>
                                <td class="text-end pe-4">
                                    <a asp-action="GetById" asp-route-id="@transaction.Id" class="btn btn-sm btn-outline-secondary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}