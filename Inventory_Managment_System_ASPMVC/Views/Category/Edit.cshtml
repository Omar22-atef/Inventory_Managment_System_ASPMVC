@model CreateCategoryViewModel
@{
    ViewData["Title"] = "Edit Category";
}

<div class="mb-4">
    <h2 class="fw-bold mb-1">Edit Category</h2>
    <p class="text-muted mb-0">Update information for @(Model?.Name ?? "this category")</p>
</div>

<div class="row">
    <div class="col-xl-6 col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">
                <form action="/Category/Edit" method="post">
                    <input type="hidden" name="Id" value="@Model?.Id"/>
                    
                    <div class="mb-4">
                        <label class="form-label fw-bold" for="Name">Name</label>
                        <input class="form-control" type="text" id="Name" name="Name" value="@Model?.Name" />
                    </div>
                    
                    <div class="mb-5">
                        <label class="form-label fw-bold" for="Description">Description</label>
                        <textarea class="form-control" id="Description" name="Description" rows="3">@Model?.Description</textarea>
                    </div>
                    
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save me-1"></i> Save Changes
                        </button>
                        <a href="/Category" class="btn btn-light px-4 border">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
