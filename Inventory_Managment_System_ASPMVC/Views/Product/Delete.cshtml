@model Product
@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<div class="alert alert-danger">
	Are you sure you want to delete this product?
</div>

<form asp-action="DeleteConfirmed" method="post">
	<input type="hidden" asp-for="Id" />
	<div class="mb-3">
		<label class="form-label">Name</label>
		<input asp-for="Name" class="form-control" readonly />
	</div>
	<div class="mb-3">
		<label class="form-label">Description</label>
		<textarea asp-for="Description" class="form-control" readonly></textarea>
	</div>
	<div class="mb-3">
		<label class="form-label">SKU</label>
		<input asp-for="SKU" class="form-control" readonly />
	</div>
	<div class="mb-3">
		<label class="form-label">Purchase Price</label>
		<input asp-for="PurchasePrice" class="form-control" readonly />
	</div>
	<div class="mb-3">
		<label class="form-label">Selling Price</label>
		<input asp-for="SellingPrice" class="form-control" readonly />
	</div>
	<div class="mb-3">
		<label class="form-label">Current Stock</label>
		<input asp-for="CurrentStock" class="form-control" readonly />
	</div>
	<div class="mb-3">
		<label class="form-label">Minimum Stock</label>
		<input asp-for="MinimumStock" class="form-control" readonly />
	</div>
	<button type="submit" class="btn btn-danger">Delete</button>
	<a asp-action="Index" class="btn btn-secondary">Cancel</a>

</form>
