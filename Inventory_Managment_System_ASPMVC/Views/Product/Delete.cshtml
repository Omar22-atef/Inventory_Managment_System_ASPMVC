@model Product
@{
    ViewData["Title"] = "Delete Product";
}

<div class="mb-4">
    <h2 class="fw-bold text-danger mb-1"><i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Product</h2>
    <p class="text-muted mb-0">Confirm deletion of this inventory item</p>
</div>

<div class="row">
    <div class="col-xl-6 col-lg-8">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger bg-opacity-10 text-danger border-danger border-opacity-25 fw-bold">
                Are you sure you want to delete this product?
            </div>
            <div class="card-body p-4">
                <form asp-action="DeleteConfirmed" method="post">
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold text-uppercase mb-1">Name</label>
                            <p class="fw-medium text-dark mb-0 form-control bg-light">@Model.Name</p>
                            <input type="hidden" asp-for="Name" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold text-uppercase mb-1">SKU</label>
                            <p class="fw-medium text-dark mb-0 form-control bg-light">@Model.SKU</p>
                            <input type="hidden" asp-for="SKU" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted small fw-bold text-uppercase mb-1">Description</label>
                        <p class="fw-medium text-dark mb-0 form-control bg-light" style="min-height: 60px;">@Model.Description</p>
                        <input type="hidden" asp-for="Description" />
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <label class="form-label text-muted small fw-bold text-uppercase mb-1">Purchase Price</label>
                            <p class="fw-medium text-dark mb-0 form-control bg-light">@Model.PurchasePrice.ToString("C2")</p>
                            <input type="hidden" asp-for="PurchasePrice" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label text-muted small fw-bold text-uppercase mb-1">Selling Price</label>
                            <p class="fw-medium text-dark mb-0 form-control bg-light">@Model.SellingPrice.ToString("C2")</p>
                            <input type="hidden" asp-for="SellingPrice" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label text-muted small fw-bold text-uppercase mb-1">Current Stock</label>
                            <p class="fw-medium text-dark mb-0 form-control bg-light">@Model.CurrentStock</p>
                            <input type="hidden" asp-for="CurrentStock" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label text-muted small fw-bold text-uppercase mb-1">Minimum Stock</label>
                            <p class="fw-medium text-dark mb-0 form-control bg-light">@Model.MinimumStock</p>
                            <input type="hidden" asp-for="MinimumStock" />
                        </div>
                    </div>

                    <div class="alert alert-warning d-flex align-items-center" role="alert">
                        <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                        <div>This action cannot be undone. All data related to this product will be permanently removed.</div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-trash me-1"></i> Delete Permanently
                        </button>
                        <a asp-action="Index" class="btn btn-light px-4 border">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
