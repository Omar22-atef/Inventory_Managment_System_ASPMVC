@model IEnumerable<ProductCategoryViewModel>

@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Products</h2>
        <p class="text-muted mb-0">Manage your inventory items</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Create New Product
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Name</th>
                        <th>Description</th>
                        <th>SKU</th>
                        <th class="text-end">Purchase Price</th>
                        <th class="text-end">Selling Price</th>
                        <th class="text-center">Current Stock</th>
                        <th class="text-center">Min Stock</th>
                        <th>Category</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-medium text-dark">@product.Name</td>
                            <td class="text-muted text-truncate" style="max-width: 150px;" title="@product.Description">
                                @product.Description
                            </td>
                            <td><span class="badge bg-light text-dark border">@product.SKU</span></td>
                            <td class="text-end">@product.PurchasePrice.ToString("C2")</td>
                            <td class="text-end">@product.SellingPrice.ToString("C2")</td>
                            <td class="text-center">
                                @if (product.CurrentStock <= product.MinimumStock)
                                {
                                    <span class="badge bg-danger">@product.CurrentStock</span>
                                }
                                else
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success">@product.CurrentStock</span>
                                }
                            </td>
                            <td class="text-center text-muted">@product.MinimumStock</td>
                            <td><span class="badge bg-secondary">@product.CategoryName</span></td>
                            <td class="text-end pe-4">
                                <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary me-1" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">No products found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>