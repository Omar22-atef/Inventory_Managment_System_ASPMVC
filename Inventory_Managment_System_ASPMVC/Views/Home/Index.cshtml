@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class="mb-5 overflow-hidden rounded-4" style="background-color: var(--primary); color: white; position: relative;">
    <div class="container-fluid p-5">
        <div class="row align-items-center">
            <div class="col-lg-6 z-1 position-relative py-lg-4 ps-lg-4">
                <span class="badge bg-white bg-opacity-25 text-white mb-3 px-3 py-2 border border-white border-opacity-25">v2.0 Professional Edition</span>
                <h1 class="display-5 fw-bold mb-3" style="letter-spacing: -0.03em;">Manage your inventory with clarity, control, and confidence.</h1>
                <p class="lead mb-4 text-white text-opacity-75" style="max-width: 500px; font-weight: 400;">
                    A unified platform for tracking stock, managing suppliers, and gaining actionable insights into your daily warehouse operations.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-light btn-lg px-4 fw-semibold text-primary shadow-sm" style="border-radius: 0.5rem;">
                        <i class="bi bi-speedometer2 me-2"></i> Go to Dashboard
                    </a>
                    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-light btn-lg px-4 fw-medium" style="border-radius: 0.5rem;">
                        <i class="bi bi-box-seam me-2"></i> View Products
                    </a>
                </div>
            </div>
            
            <div class="col-lg-6 mt-5 mt-lg-0 d-flex justify-content-center justify-content-lg-end position-relative z-1 pe-lg-4">
                <!-- Custom CSS/SVG Hero Graphic (Fallback for failed image generation) -->
                <div style="width: 100%; max-width: 450px; aspect-ratio: 4/3; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 1rem; backdrop-filter: blur(10px); padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem; box-shadow: 0 20px 40px rgba(0,0,0,0.2);">
                    
                    <!-- Dashboard Mock Element -->
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="d-flex gap-2">
                            <div style="width: 12px; height: 12px; border-radius: 50%; background: #e11d48;"></div>
                            <div style="width: 12px; height: 12px; border-radius: 50%; background: #f59e0b;"></div>
                            <div style="width: 12px; height: 12px; border-radius: 50%; background: #10b981;"></div>
                        </div>
                        <div style="width: 30%; height: 8px; background: rgba(255,255,255,0.2); border-radius: 4px;"></div>
                    </div>
                    
                    <div class="row g-3 h-100">
                        <div class="col-7 d-flex flex-column gap-3">
                            <div style="flex: 1; background: rgba(255,255,255,0.1); border-radius: 0.5rem; padding: 1rem; position: relative; overflow: hidden;">
                                <div style="width: 40%; height: 12px; background: rgba(255,255,255,0.3); border-radius: 4px; margin-bottom: 12px;"></div>
                                <div class="mt-3 d-flex align-items-end gap-2 h-75">
                                    <div style="width: 20%; height: 40%; background: #0284c7; border-radius: 3px 3px 0 0;"></div>
                                    <div style="width: 20%; height: 70%; background: #10b981; border-radius: 3px 3px 0 0;"></div>
                                    <div style="width: 20%; height: 50%; background: #f59e0b; border-radius: 3px 3px 0 0;"></div>
                                    <div style="width: 20%; height: 90%; background: #e11d48; border-radius: 3px 3px 0 0;"></div>
                                </div>
                            </div>
                            <div style="flex: 1; background: rgba(255,255,255,0.1); border-radius: 0.5rem; padding: 1rem; display: flex; align-items: center;">
                                <div class="d-flex gap-3 w-100 align-items-center">
                                    <div style="width: 36px; height: 36px; border-radius: 0.5rem; background: rgba(255,255,255,0.2); display: flex; align-items:center; justify-content:center; color: white;">
                                        <i class="bi bi-box"></i>
                                    </div>
                                    <div class="w-100">
                                        <div style="width: 80%; height: 8px; background: rgba(255,255,255,0.3); border-radius: 4px; margin-bottom: 8px;"></div>
                                        <div style="width: 50%; height: 6px; background: rgba(255,255,255,0.15); border-radius: 3px;"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-5 d-flex flex-column gap-3">
                            <div style="flex: 2; background: rgba(255,255,255,0.1); border-radius: 0.5rem; display: flex; justify-content: center; align-items: center; position: relative;">
                                <i class="bi bi-truck text-white opacity-50" style="font-size: 3rem;"></i>
                                <div style="position: absolute; top: -10px; right: -10px; width: 30px; height: 30px; background: #10b981; border-radius: 50%; border: 3px solid var(--primary); display: flex; align-items: center; justify-content: center;">
                                    <i class="bi bi-check text-white" style="font-size: 1rem;"></i>
                                </div>
                            </div>
                            <div style="flex: 1; background: rgba(255,255,255,0.1); border-radius: 0.5rem; padding: 1rem;">
                                 <div style="width: 100%; height: 8px; background: rgba(255,255,255,0.2); border-radius: 4px; margin-bottom: 12px;"></div>
                                 <div style="width: 70%; height: 8px; background: rgba(255,255,255,0.2); border-radius: 4px;"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Abstract background graphic -->
            <div class="position-absolute" style="top: -20%; right: -5%; width: 500px; height: 500px; background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0) 70%); border-radius: 50%; pointer-events: none;"></div>
        </div>
    </div>
</section>

<!-- Quick Access Section -->
<section class="mb-5">
    <div class="d-flex align-items-center mb-4">
        <h3 class="fw-bold mb-0 text-dark">Quick Access</h3>
        <div class="flex-grow-1 ms-4" style="height: 1px; background: var(--border);"></div>
    </div>
    
    <div class="row g-4">
        <div class="col-md-6 col-lg-4 col-xl-2">
            <a asp-controller="Dashboard" asp-action="Index" class="text-decoration-none h-100 d-block">
                <div class="card card-interactive h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="kpi-icon bg-primary bg-opacity-10 text-primary mx-auto mb-3" style="width: 56px; height: 56px; font-size: 1.5rem;">
                            <i class="bi bi-speedometer2"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">Dashboard</h6>
                        <p class="small text-muted mb-0">System overview</p>
                    </div>
                </div>
            </a>
        </div>
        
        <div class="col-md-6 col-lg-4 col-xl-2">
            <a asp-controller="Product" asp-action="Index" class="text-decoration-none h-100 d-block">
                <div class="card card-interactive h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="kpi-icon bg-info bg-opacity-10 text-info mx-auto mb-3" style="width: 56px; height: 56px; font-size: 1.5rem;">
                            <i class="bi bi-box"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">Products</h6>
                        <p class="small text-muted mb-0">Manage stock</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-6 col-lg-4 col-xl-2">
            <a asp-controller="Category" asp-action="Index" class="text-decoration-none h-100 d-block">
                <div class="card card-interactive h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="kpi-icon bg-secondary bg-opacity-10 text-secondary mx-auto mb-3" style="width: 56px; height: 56px; font-size: 1.5rem;">
                            <i class="bi bi-tags"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">Categories</h6>
                        <p class="small text-muted mb-0">Organize items</p>
                    </div>
                </div>
            </a>
        </div>
        
        <div class="col-md-6 col-lg-4 col-xl-2">
            <a asp-controller="Supplier" asp-action="Index" class="text-decoration-none h-100 d-block">
                <div class="card card-interactive h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="kpi-icon bg-success bg-opacity-10 text-success mx-auto mb-3" style="width: 56px; height: 56px; font-size: 1.5rem;">
                            <i class="bi bi-truck"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">Suppliers</h6>
                        <p class="small text-muted mb-0">Manage vendors</p>
                    </div>
                </div>
            </a>
        </div>
        
        <div class="col-md-6 col-lg-4 col-xl-2">
            <a asp-controller="InventoryTransaction" asp-action="Index" class="text-decoration-none h-100 d-block">
                <div class="card card-interactive h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="kpi-icon bg-warning bg-opacity-10 text-warning mx-auto mb-3" style="width: 56px; height: 56px; font-size: 1.5rem;">
                            <i class="bi bi-arrow-left-right"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">Transactions</h6>
                        <p class="small text-muted mb-0">Stock logs</p>
                    </div>
                </div>
            </a>
        </div>
        
        <div class="col-md-6 col-lg-4 col-xl-2">
            <a asp-controller="UserManagement" asp-action="Index" class="text-decoration-none h-100 d-block">
                <div class="card card-interactive h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="kpi-icon bg-dark bg-opacity-10 text-dark mx-auto mb-3" style="width: 56px; height: 56px; font-size: 1.5rem;">
                            <i class="bi bi-people"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">Users</h6>
                        <p class="small text-muted mb-0">Admin control</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
</section>

<!-- Visual Workflow Section -->
<section class="mb-5 py-5 rounded-4" style="background-color: var(--surface); border: 1px solid var(--border);">
    <div class="container-fluid px-4 text-center">
        <h3 class="fw-bold mb-2 text-dark">How It Works</h3>
        <p class="text-muted mb-5">A seamless flow from product sourcing to data insights.</p>
        
        <div class="row align-items-center justify-content-center position-relative">
            <!-- connecting line -->
            <div class="d-none d-lg-block position-absolute" style="top: 30%; left: 10%; right: 10%; height: 2px; background-color: var(--border); z-index: 0;"></div>
            
            <div class="col-12 col-lg-2 mb-4 mb-lg-0 position-relative z-1">
                <div class="bg-white border rounded-circle d-flex align-items-center justify-content-center mx-auto shadow-sm" style="width: 72px; height: 72px;">
                    <i class="bi bi-truck fs-3 text-success"></i>
                </div>
                <h6 class="fw-bold mt-3 mb-1">Suppliers</h6>
                <small class="text-muted d-block px-2">Source and manage inventory vendors.</small>
                <div class="d-lg-none mt-3"><i class="bi bi-arrow-down text-muted fs-4"></i></div>
            </div>
            
            <div class="col-12 col-lg-2 mb-4 mb-lg-0 position-relative z-1">
                <div class="bg-white border rounded-circle d-flex align-items-center justify-content-center mx-auto shadow-sm" style="width: 72px; height: 72px;">
                    <i class="bi bi-box fs-3 text-info"></i>
                </div>
                <h6 class="fw-bold mt-3 mb-1">Products</h6>
                <small class="text-muted d-block px-2">Catalog items and maintain descriptions.</small>
                <div class="d-lg-none mt-3"><i class="bi bi-arrow-down text-muted fs-4"></i></div>
            </div>
            
            <div class="col-12 col-lg-2 mb-4 mb-lg-0 position-relative z-1">
                <div class="bg-white border rounded-circle d-flex align-items-center justify-content-center mx-auto shadow-sm" style="width: 72px; height: 72px; border-color: var(--primary) !important;">
                    <i class="bi bi-arrow-left-right fs-3 text-primary"></i>
                </div>
                <h6 class="fw-bold mt-3 mb-1">Transactions</h6>
                <small class="text-muted d-block px-2">Log stock movements in and out.</small>
                <div class="d-lg-none mt-3"><i class="bi bi-arrow-down text-muted fs-4"></i></div>
            </div>
            
            <div class="col-12 col-lg-2 mb-4 mb-lg-0 position-relative z-1">
                <div class="bg-white border rounded-circle d-flex align-items-center justify-content-center mx-auto shadow-sm" style="width: 72px; height: 72px;">
                    <i class="bi bi-database-check fs-3 text-warning"></i>
                </div>
                <h6 class="fw-bold mt-3 mb-1">Monitoring</h6>
                <small class="text-muted d-block px-2">Track real-time stock levels and limits.</small>
                <div class="d-lg-none mt-3"><i class="bi bi-arrow-down text-muted fs-4"></i></div>
            </div>
            
            <div class="col-12 col-lg-2 position-relative z-1">
                <div class="bg-white border rounded-circle d-flex align-items-center justify-content-center mx-auto shadow-sm" style="width: 72px; height: 72px;">
                    <i class="bi bi-graph-up-arrow fs-3 text-danger"></i>
                </div>
                <h6 class="fw-bold mt-3 mb-1">Insights</h6>
                <small class="text-muted d-block px-2">Analyze dashboard KPIs and metrics.</small>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="mb-2">
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card h-100 border-0 shadow-sm card-interactive">
                <div class="card-body p-4 d-flex">
                    <div class="me-4 mt-1">
                        <div class="bg-primary bg-opacity-10 text-primary rounded d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="bi bi-boxes fs-4"></i>
                        </div>
                    </div>
                    <div>
                        <h5 class="fw-bold text-dark mb-2">Inventory Control</h5>
                        <p class="text-muted mb-0">Maintain accurate product records, organize items into clear categories, and keep your entire stock catalog easily searchable and accessible.</p>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-lg-6">
            <div class="card h-100 border-0 shadow-sm card-interactive">
                <div class="card-body p-4 d-flex">
                    <div class="me-4 mt-1">
                        <div class="bg-success bg-opacity-10 text-success rounded d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="bi bi-buildings fs-4"></i>
                        </div>
                    </div>
                    <div>
                        <h5 class="fw-bold text-dark mb-2">Supplier Management</h5>
                        <p class="text-muted mb-0">Build strong vendor relationships by managing supplier contact information and linking them directly to the products they provide.</p>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-lg-6">
            <div class="card h-100 border-0 shadow-sm card-interactive">
                <div class="card-body p-4 d-flex">
                    <div class="me-4 mt-1">
                        <div class="bg-warning bg-opacity-10 text-warning rounded d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="bi bi-clock-history fs-4"></i>
                        </div>
                    </div>
                    <div>
                        <h5 class="fw-bold text-dark mb-2">Stock Transactions</h5>
                        <p class="text-muted mb-0">Keep a reliable historical ledger of all stock movements. Track every item that comes in and out of your warehouse with precision.</p>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-lg-6">
            <div class="card h-100 border-0 shadow-sm card-interactive">
                <div class="card-body p-4 d-flex">
                    <div class="me-4 mt-1">
                        <div class="bg-danger bg-opacity-10 text-danger rounded d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="bi bi-shield-lock fs-4"></i>
                        </div>
                    </div>
                    <div>
                        <h5 class="fw-bold text-dark mb-2">Secure Administration</h5>
                        <p class="text-muted mb-0">Control who has access to your system. Manage user accounts, assign specific roles, and securely enable or disable profiles.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
