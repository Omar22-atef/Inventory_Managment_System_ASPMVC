@model LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "_Layout"; // Keep the standard layout which now handles unauthenticated state gracefully.
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5 col-xl-4">
        <div class="card border-0 shadow-sm mt-5">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <i class="bi bi-person-badge fs-1 text-primary"></i>
                    <h3 class="fw-bold text-dark mt-2">Sign In</h3>
                    <p class="text-muted">Access your inventory dashboard</p>
                </div>

                <form asp-action="Login" method="post">
                    
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 fs-6"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control border-start-0" placeholder="name@company.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" class="form-control border-start-0" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label text-muted">
                            Keep me signed in
                        </label>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg rounded-3">
                            <i class="bi bi-box-arrow-in-right me-2"></i> Login
                        </button>
                    </div>

                </form>
            </div>
        </div>
        <div class="text-center mt-4">
            <p class="text-muted small">&copy; @DateTime.Now.Year Inventory Management System. All rights reserved.</p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}