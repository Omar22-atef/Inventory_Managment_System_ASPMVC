<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventory Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Inventory_Managment_System_ASPMVC.styles.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="wrapper">
            <!-- Sidebar -->
            <nav id="sidebar" class="sidebar">
                <a class="sidebar-header" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-box-seam me-2"></i> Inventory
                </a>
                <div class="sidebar-nav">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-speedometer2"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Product" asp-action="Index">
                                <i class="bi bi-box"></i> Products
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Category" asp-action="Index">
                                <i class="bi bi-tags"></i> Categories
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Supplier" asp-action="Index">
                                <i class="bi bi-truck"></i> Suppliers
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="InventoryTransaction" asp-action="Index">
                                <i class="bi bi-arrow-left-right"></i> Transactions
                            </a>
                        </li>
                        @if (User.IsInRole("SuperAdmin"))
                        {
                        <li class="nav-item mt-4">
                            <span class="ps-4 text-muted small fw-bold text-uppercase">Administration</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="UserManagement" asp-action="Index">
                                <i class="bi bi-people"></i> Users
                            </a>
                        </li>
                        }
                    </ul>
                </div>
            </nav>

            <!-- Main Content -->
            <div class="main-content">
                <!-- Topbar -->
                <header class="topbar">
                    <div class="d-flex align-items-center">
                        <button class="btn btn-link d-md-none me-3 px-0 text-dark" type="button" onclick="document.getElementById('sidebar').classList.toggle('show')">
                            <i class="bi bi-list fs-3"></i>
                        </button>
                        <h5 class="mb-0 text-muted d-none d-sm-block">@ViewData["Title"]</h5>
                    </div>
                    <div class="topbar-right">
                        <span class="user-info">
                            <i class="bi bi-person-circle me-1"></i> @User.Identity.Name
                        </span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-box-arrow-right"></i> Logout
                            </button>
                        </form>
                    </div>
                </header>

                <!-- Page Content -->
                <main class="content-area">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <!-- Unauthenticated Layout -->
        <header class="topbar justify-content-center">
            <span class="sidebar-header border-0 fs-4">
                <i class="bi bi-box-seam me-2"></i> Inventory Management System
            </span>
        </header>
        <main class="content-area bg-light" style="min-height: calc(100vh - 60px);">
            <div class="container">
                @RenderBody()
            </div>
        </main>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script>
        // Set active nav link
        $(document).ready(function () {
            var currentUrl = window.location.pathname.toLowerCase();
            $('.sidebar-nav .nav-link').each(function () {
                var href = $(this).attr('href').toLowerCase();
                if (href !== '/' && currentUrl.indexOf(href) !== -1) {
                    $(this).addClass('active');
                } else if (href === '/' && (currentUrl === '/' || currentUrl === '/home/index')) {
                    $(this).addClass('active');
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
