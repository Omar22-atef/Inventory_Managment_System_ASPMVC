@model IEnumerable<UserListViewModel>

@{
    ViewData["Title"] = "Users";
}

<h1>Users</h1>

<a asp-action="Create" class="btn btn-primary mb-3">
    Create User
</a>

<table class="table">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.FullName</td>
                <td>@user.Email</td>
                <td>@string.Join(", ", user.Roles)</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@user.Id"
                       class="btn btn-sm btn-primary">
                        Edit
                    </a>

                    @if (user.IsDisabled)
                    {
                        <form asp-action="Enable"
                              asp-route-id="@user.Id"
                              method="post"
                              class="d-inline">

                            <button type="submit" class="btn btn-sm btn-success">
                                Enable
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Disable"
                              asp-route-id="@user.Id"
                              method="post"
                              class="d-inline">

                            <button type="submit" class="btn btn-sm btn-danger">
                                Disable
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>